{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract",
  "description": "tw-stock-terminal 靜態資料契約（由 pipeline 自動產生，請勿手改）",
  "x-contract-version": 1,
  "type": "object",
  "properties": {
    "Meta": {
      "$ref": "#/$defs/Meta"
    },
    "Calendar": {
      "$ref": "#/$defs/Calendar"
    },
    "Securities": {
      "$ref": "#/$defs/Securities"
    },
    "Bars": {
      "$ref": "#/$defs/Bars"
    },
    "Flows": {
      "$ref": "#/$defs/Flows"
    },
    "MarketFlows": {
      "$ref": "#/$defs/MarketFlows"
    },
    "IndustryFlows": {
      "$ref": "#/$defs/IndustryFlows"
    },
    "Overview": {
      "$ref": "#/$defs/Overview"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SourceHealth": {
      "additionalProperties": false,
      "description": "一個資料來源的狀態。",
      "properties": {
        "id": {
          "description": "來源代號，例如 twse_daily",
          "type": "string"
        },
        "name": {
          "description": "顯示名稱",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "partial",
            "pending",
            "error"
          ],
          "type": "string"
        },
        "last_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "該來源最新一筆資料的日期"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "last_date",
        "note"
      ],
      "title": "SourceHealth",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "data/meta.json：網站啟動時第一個讀的檔案。",
      "properties": {
        "contract_version": {
          "default": 1,
          "type": "integer"
        },
        "generated_at": {
          "description": "輸出時間（含時區）",
          "format": "date-time",
          "type": "string"
        },
        "data_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "資料截止日：最後一個有收盤資料的交易日"
        },
        "coverage_start": {
          "description": "資料起始日",
          "format": "date",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceHealth"
          },
          "type": "array"
        },
        "tracked": {
          "description": "追蹤池代號",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "build_notes": {
          "description": "建置時做的取捨，顯示在「關於」頁",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "generated_at",
        "data_as_of",
        "coverage_start",
        "sources",
        "tracked",
        "build_notes"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Calendar": {
      "additionalProperties": false,
      "description": "data/calendar.json：資料期間的所有交易日（遞增）。\n\n其他檔案的日序列不重複寫日期，而是用 `start`（這份日曆的索引）對齊：\n陣列第 i 個值對應 `dates[start + i]`。",
      "properties": {
        "dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "dates"
      ],
      "title": "Calendar",
      "type": "object"
    },
    "SecurityInfo": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "stock",
            "etf"
          ],
          "type": "string"
        },
        "industry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "產業名稱；ETF 為 ETF"
        },
        "tracked": {
          "description": "是否在追蹤池（有模型預測與事件分析）",
          "type": "boolean"
        },
        "first": {
          "description": "資料期間內第一個交易日",
          "format": "date",
          "type": "string"
        },
        "last": {
          "description": "資料期間內最後一個交易日",
          "format": "date",
          "type": "string"
        },
        "active": {
          "description": "資料截止日仍有交易（未下市）",
          "type": "boolean"
        }
      },
      "required": [
        "symbol",
        "name",
        "kind",
        "industry",
        "tracked",
        "first",
        "last",
        "active"
      ],
      "title": "SecurityInfo",
      "type": "object"
    },
    "Securities": {
      "additionalProperties": false,
      "description": "data/securities.json：所有上市股票與 ETF（搜尋用，啟動時載入）。",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/SecurityInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "Securities",
      "type": "object"
    },
    "ActionInfo": {
      "additionalProperties": false,
      "properties": {
        "ex_date": {
          "format": "date",
          "type": "string"
        },
        "type": {
          "description": "dividend_cash / dividend_stock / dividend_both / capital_reduction / par_change / etf_split / etf_reverse_split",
          "type": "string"
        },
        "prev_close": {
          "type": "number"
        },
        "ref_price": {
          "type": "number"
        },
        "factor": {
          "description": "參考價 ÷ 前收。ex_date 之前每一天的價格乘以這個值即為還原價",
          "type": "number"
        },
        "affects_shares": {
          "description": "是否改變股數（成交量也要還原）",
          "type": "boolean"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ex_date",
        "type",
        "prev_close",
        "ref_price",
        "factor",
        "affects_shares",
        "detail"
      ],
      "title": "ActionInfo",
      "type": "object"
    },
    "Bars": {
      "additionalProperties": false,
      "description": "data/bars/{symbol}.json：原始（未還原）日線。\n\n陣列與 calendar.dates[start:] 對齊；沒有成交的日子價格為 null、量為 0。\n還原價由前端用 actions 計算：某日的累積因子 = 所有 ex_date 在該日之後的 factor 乘積。",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "start": {
          "description": "第一個值在 calendar.dates 中的索引",
          "type": "integer"
        },
        "open": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "high": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "low": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "close": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "volume": {
          "description": "成交量（張，1 張 = 1,000 股）",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "value": {
          "description": "成交金額（千元）",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/ActionInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "start",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "value",
        "actions"
      ],
      "title": "Bars",
      "type": "object"
    },
    "Flows": {
      "additionalProperties": false,
      "description": "data/flows/{symbol}.json：法人買賣超與外資持股。日序列與 calendar 對齊。",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "foreign_net": {
          "description": "外資（不含外資自營商）買賣超，張",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "trust_net": {
          "description": "投信買賣超，張",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "dealer_net": {
          "description": "自營商買賣超，張",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "foreign_value": {
          "description": "外資買賣超估算金額（百萬元）= 股數 × 當日收盤價",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "holding_dates": {
          "description": "外資持股比率的日期（每週最後一個交易日與資料截止日）",
          "items": {
            "format": "date",
            "type": "string"
          },
          "type": "array"
        },
        "foreign_pct": {
          "description": "外資持股比率（%）",
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "start",
        "foreign_net",
        "trust_net",
        "dealer_net",
        "foreign_value",
        "holding_dates",
        "foreign_pct"
      ],
      "title": "Flows",
      "type": "object"
    },
    "MarketFlows": {
      "additionalProperties": false,
      "description": "data/flows/market.json：全市場各類法人每日買賣差額（億元，證交所實際金額）。",
      "properties": {
        "start": {
          "type": "integer"
        },
        "foreign": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "trust": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "dealer": {
          "description": "自營商（自行買賣 + 避險）",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "total": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "start",
        "foreign",
        "trust",
        "dealer",
        "total"
      ],
      "title": "MarketFlows",
      "type": "object"
    },
    "IndustryFlowSeries": {
      "additionalProperties": false,
      "properties": {
        "industry": {
          "type": "string"
        },
        "foreign_value": {
          "description": "每週外資估算淨流入（億元）",
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "industry",
        "foreign_value"
      ],
      "title": "IndustryFlowSeries",
      "type": "object"
    },
    "IndustryFlows": {
      "additionalProperties": false,
      "description": "data/flows/industry.json：各產業每週的外資估算淨流入。",
      "properties": {
        "weeks": {
          "description": "每週最後一個交易日",
          "items": {
            "format": "date",
            "type": "string"
          },
          "type": "array"
        },
        "industries": {
          "items": {
            "$ref": "#/$defs/IndustryFlowSeries"
          },
          "type": "array"
        }
      },
      "required": [
        "weeks",
        "industries"
      ],
      "title": "IndustryFlows",
      "type": "object"
    },
    "Breadth": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer"
        },
        "up": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "down": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "flat": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "start",
        "up",
        "down",
        "flat"
      ],
      "title": "Breadth",
      "type": "object"
    },
    "IndexSeries": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "close": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "start",
        "close"
      ],
      "title": "IndexSeries",
      "type": "object"
    },
    "SectorPerf": {
      "additionalProperties": false,
      "properties": {
        "industry": {
          "type": "string"
        },
        "index_id": {
          "type": "string"
        },
        "close": {
          "type": "number"
        },
        "change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "資料截止日的漲跌幅（%）"
        },
        "ret_1m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "近 21 個交易日報酬（%）"
        },
        "ret_ytd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "今年以來報酬（%）"
        },
        "ret_1y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "近 252 個交易日報酬（%）"
        }
      },
      "required": [
        "industry",
        "index_id",
        "close",
        "change_pct",
        "ret_1m",
        "ret_ytd",
        "ret_1y"
      ],
      "title": "SectorPerf",
      "type": "object"
    },
    "Overview": {
      "additionalProperties": false,
      "description": "data/market/overview.json：大盤、類股表現、漲跌家數。",
      "properties": {
        "taiex": {
          "$ref": "#/$defs/IndexSeries"
        },
        "sectors": {
          "items": {
            "$ref": "#/$defs/SectorPerf"
          },
          "type": "array"
        },
        "breadth": {
          "$ref": "#/$defs/Breadth"
        }
      },
      "required": [
        "taiex",
        "sectors",
        "breadth"
      ],
      "title": "Overview",
      "type": "object"
    }
  }
}
