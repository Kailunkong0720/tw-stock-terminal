{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract",
  "description": "tw-stock-terminal 靜態資料契約（由 pipeline 自動產生，請勿手改）",
  "x-contract-version": 1,
  "type": "object",
  "properties": {
    "Moves": {
      "$ref": "#/$defs/Moves"
    },
    "Events": {
      "$ref": "#/$defs/Events"
    },
    "Timeline": {
      "$ref": "#/$defs/Timeline"
    },
    "Forecast": {
      "$ref": "#/$defs/Forecast"
    },
    "Backtest": {
      "$ref": "#/$defs/Backtest"
    },
    "Ranking": {
      "$ref": "#/$defs/Ranking"
    },
    "Meta": {
      "$ref": "#/$defs/Meta"
    },
    "Calendar": {
      "$ref": "#/$defs/Calendar"
    },
    "Securities": {
      "$ref": "#/$defs/Securities"
    },
    "Bars": {
      "$ref": "#/$defs/Bars"
    },
    "Flows": {
      "$ref": "#/$defs/Flows"
    },
    "MarketFlows": {
      "$ref": "#/$defs/MarketFlows"
    },
    "IndustryFlows": {
      "$ref": "#/$defs/IndustryFlows"
    },
    "Overview": {
      "$ref": "#/$defs/Overview"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "description": "某個異常波動日的候選事件（可能相關，不是原因）。",
      "properties": {
        "id": {
          "type": "integer"
        },
        "at": {
          "description": "公告／發生時間（台北時間）",
          "format": "date-time",
          "type": "string"
        },
        "trade_date": {
          "description": "影響的交易日（盤後公告算下一個交易日）",
          "format": "date",
          "type": "string"
        },
        "level": {
          "enum": [
            "official",
            "media",
            "market"
          ],
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "type_name": {
          "type": "string"
        },
        "direction": {
          "description": "+1 利多、−1 利空、0 無法判斷",
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": "number"
        },
        "components": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "relevance、prior、direction、proximity、credibility",
          "type": "object"
        }
      },
      "required": [
        "id",
        "at",
        "trade_date",
        "level",
        "type",
        "type_name",
        "direction",
        "title",
        "source",
        "url",
        "score",
        "components"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "MoveOut": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "type": "string"
        },
        "ret": {
          "description": "還原後報酬",
          "type": "number"
        },
        "gap": {
          "description": "與前一個有成交日之間隔了幾個交易日",
          "type": "integer"
        },
        "mkt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "大盤貢獻"
        },
        "sector": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "類股（相對大盤）貢獻"
        },
        "overnight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "前一晚費半貢獻"
        },
        "idio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "個股特有"
        },
        "z": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "vol_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "成交量 ÷ 前 20 日均量"
        },
        "foreign_lots": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "當日外資買賣超（張）"
        },
        "foreign_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "當日外資買賣超估算金額（百萬元）"
        },
        "foreign_rank": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "當日外資買賣超金額的絕對值在該股歷史中的百分位（0–1）"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "type": "array"
        }
      },
      "required": [
        "date",
        "ret",
        "gap",
        "mkt",
        "sector",
        "overnight",
        "idio",
        "z",
        "vol_ratio",
        "foreign_lots",
        "foreign_value",
        "foreign_rank",
        "candidates"
      ],
      "title": "MoveOut",
      "type": "object"
    },
    "Moves": {
      "additionalProperties": false,
      "description": "data/moves/{symbol}.json：異常波動日與可能相關的事件。",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "tracked": {
          "description": "只有追蹤池有事件歸因",
          "type": "boolean"
        },
        "thresholds": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        "moves": {
          "items": {
            "$ref": "#/$defs/MoveOut"
          },
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "tracked",
        "thresholds",
        "moves"
      ],
      "title": "Moves",
      "type": "object"
    },
    "EventOut": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "at": {
          "description": "公告／發生時間（台北時間）",
          "format": "date-time",
          "type": "string"
        },
        "trade_date": {
          "description": "影響的交易日（盤後公告算下一個交易日）",
          "format": "date",
          "type": "string"
        },
        "level": {
          "enum": [
            "official",
            "media",
            "market"
          ],
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "type_name": {
          "type": "string"
        },
        "direction": {
          "description": "+1 利多、−1 利空、0 無法判斷",
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "at",
        "trade_date",
        "level",
        "type",
        "type_name",
        "direction",
        "title",
        "source",
        "url"
      ],
      "title": "EventOut",
      "type": "object"
    },
    "Events": {
      "additionalProperties": false,
      "description": "data/events/{symbol}.json：個股的重大訊息（不含例行公告）。",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EventOut"
          },
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "events"
      ],
      "title": "Events",
      "type": "object"
    },
    "TimelineMove": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "date": {
          "format": "date",
          "type": "string"
        },
        "ret": {
          "type": "number"
        },
        "idio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "top": {
          "anyOf": [
            {
              "$ref": "#/$defs/Candidate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "symbol",
        "name",
        "date",
        "ret",
        "idio",
        "top"
      ],
      "title": "TimelineMove",
      "type": "object"
    },
    "Timeline": {
      "additionalProperties": false,
      "description": "data/events/timeline.json：市場事件與追蹤池最大的異常波動。",
      "properties": {
        "market": {
          "items": {
            "$ref": "#/$defs/EventOut"
          },
          "type": "array"
        },
        "moves": {
          "items": {
            "$ref": "#/$defs/TimelineMove"
          },
          "type": "array"
        }
      },
      "required": [
        "market",
        "moves"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "ForecastStepOut": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "description": "基準日之後第幾個交易日（1 起算）",
          "type": "integer"
        },
        "p05": {
          "type": "number"
        },
        "p25": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p75": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        },
        "up_prob": {
          "description": "收盤高於基準日收盤的路徑比例",
          "type": "number"
        }
      },
      "required": [
        "step",
        "p05",
        "p25",
        "p50",
        "p75",
        "p95",
        "up_prob"
      ],
      "title": "ForecastStepOut",
      "type": "object"
    },
    "SignalOut": {
      "additionalProperties": false,
      "properties": {
        "horizon": {
          "description": "交易日數：5、10、20",
          "type": "integer"
        },
        "up_prob": {
          "type": "number"
        },
        "exp_ret": {
          "description": "期末報酬中位數",
          "type": "number"
        },
        "p10_ret": {
          "description": "期末報酬第 10 百分位（下檔風險）",
          "type": "number"
        },
        "mdd_p50": {
          "description": "途中最大回檔中位數（負值）",
          "type": "number"
        },
        "label": {
          "description": "偏多／略偏多／中性／略偏空／偏空",
          "type": "string"
        }
      },
      "required": [
        "horizon",
        "up_prob",
        "exp_ret",
        "p10_ret",
        "mdd_p50",
        "label"
      ],
      "title": "SignalOut",
      "type": "object"
    },
    "TrackRecord": {
      "additionalProperties": false,
      "description": "模型在回測中的方向命中率，與兩種單純基準比較。",
      "properties": {
        "horizon": {
          "type": "integer"
        },
        "n": {
          "description": "回測樣本數（不含平盤）",
          "type": "integer"
        },
        "hit_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "方向命中率"
        },
        "baseline_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "較好的單純基準：一律看多數方向、或延續近 20 日趨勢"
        },
        "always_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "一律看多數方向的命中率"
        },
        "momentum_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "延續近 20 日趨勢的命中率"
        },
        "z": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_edge": {
          "description": "命中率明顯優於基準（單尾 p < 0.1，樣本至少 20）",
          "type": "boolean"
        }
      },
      "required": [
        "horizon",
        "n",
        "hit_rate",
        "baseline_rate",
        "always_rate",
        "momentum_rate",
        "z",
        "has_edge"
      ],
      "title": "TrackRecord",
      "type": "object"
    },
    "Forecast": {
      "additionalProperties": false,
      "description": "data/forecast/{symbol}.json：最新預測。價格為基準日的還原價（＝基準日的原始收盤尺度）。",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "base_date": {
          "format": "date",
          "type": "string"
        },
        "base_close": {
          "type": "number"
        },
        "future_dates": {
          "description": "預測的各交易日（假日以平日估計）",
          "items": {
            "format": "date",
            "type": "string"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ForecastStepOut"
          },
          "type": "array"
        },
        "paths": {
          "description": "各條取樣路徑的收盤價",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/SignalOut"
          },
          "type": "array"
        },
        "track": {
          "items": {
            "$ref": "#/$defs/TrackRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "model",
        "base_date",
        "base_close",
        "future_dates",
        "steps",
        "paths",
        "signals",
        "track"
      ],
      "title": "Forecast",
      "type": "object"
    },
    "BacktestPoint": {
      "additionalProperties": false,
      "properties": {
        "base_date": {
          "format": "date",
          "type": "string"
        },
        "base_close": {
          "description": "以基準日當下已知的公司行動還原的收盤（＝當日原始收盤）",
          "type": "number"
        },
        "scale": {
          "description": "換算成目前還原價要乘上的因子（基準日之後的公司行動）",
          "type": "number"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ForecastStepOut"
          },
          "type": "array"
        },
        "actual": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "實際報酬，鍵為 5、10、20",
          "type": "object"
        },
        "exp": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "模型預期報酬（中位數），鍵為 5、10、20",
          "type": "object"
        }
      },
      "required": [
        "base_date",
        "base_close",
        "scale",
        "steps",
        "actual",
        "exp"
      ],
      "title": "BacktestPoint",
      "type": "object"
    },
    "Backtest": {
      "additionalProperties": false,
      "description": "data/forecast/backtest/{symbol}.json：回測重播用。",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/BacktestPoint"
          },
          "type": "array"
        },
        "track": {
          "items": {
            "$ref": "#/$defs/TrackRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "model",
        "points",
        "track"
      ],
      "title": "Backtest",
      "type": "object"
    },
    "RankIC": {
      "additionalProperties": false,
      "properties": {
        "horizon": {
          "type": "integer"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "各基準日橫斷面 Spearman 相關的平均"
        },
        "n_dates": {
          "type": "integer"
        },
        "positive_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rank IC 為正的基準日比例"
        }
      },
      "required": [
        "horizon",
        "mean",
        "n_dates",
        "positive_share"
      ],
      "title": "RankIC",
      "type": "object"
    },
    "RankingItem": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "industry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "base_date": {
          "format": "date",
          "type": "string"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/SignalOut"
          },
          "type": "array"
        },
        "track": {
          "items": {
            "$ref": "#/$defs/TrackRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "name",
        "industry",
        "base_date",
        "signals",
        "track"
      ],
      "title": "RankingItem",
      "type": "object"
    },
    "Ranking": {
      "additionalProperties": false,
      "description": "data/forecast/ranking.json：追蹤池的訊號排行與模型整體表現。",
      "properties": {
        "model": {
          "type": "string"
        },
        "settings": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "lookback、pred_len、n_paths、backtest_every、backtest_years",
          "type": "object"
        },
        "label_rules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/RankingItem"
          },
          "type": "array"
        },
        "pool": {
          "description": "整個追蹤池合計的命中率",
          "items": {
            "$ref": "#/$defs/TrackRecord"
          },
          "type": "array"
        },
        "rank_ic": {
          "items": {
            "$ref": "#/$defs/RankIC"
          },
          "type": "array"
        },
        "backtest_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "model",
        "settings",
        "label_rules",
        "items",
        "pool",
        "rank_ic",
        "backtest_dates"
      ],
      "title": "Ranking",
      "type": "object"
    },
    "SourceHealth": {
      "additionalProperties": false,
      "description": "一個資料來源的狀態。",
      "properties": {
        "id": {
          "description": "來源代號，例如 twse_daily",
          "type": "string"
        },
        "name": {
          "description": "顯示名稱",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "partial",
            "pending",
            "error"
          ],
          "type": "string"
        },
        "last_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "該來源最新一筆資料的日期"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "last_date",
        "note"
      ],
      "title": "SourceHealth",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "data/meta.json：網站啟動時第一個讀的檔案。",
      "properties": {
        "contract_version": {
          "default": 1,
          "type": "integer"
        },
        "generated_at": {
          "description": "輸出時間（含時區）",
          "format": "date-time",
          "type": "string"
        },
        "data_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "資料截止日：最後一個有收盤資料的交易日"
        },
        "coverage_start": {
          "description": "資料起始日",
          "format": "date",
          "type": "string"
